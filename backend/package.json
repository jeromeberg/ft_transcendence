{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "nest build",
    "start:prod": "node dist/src/main",
    "start:dev": "nest start --watch",
    "seed": "npm run quotes && ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "quotes": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/quotes.ts",
    "stress": "npm run quotes && ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/stress.ts",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"prisma/*.ts\""
  },
  "dependencies": {
    "@nestjs/common": "^11.2.4",
    "@nestjs/core": "^11.2.4",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.4",
    "@nestjs/platform-socket.io": "^11.2.4",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.2.4",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.9.6",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "3.9.6",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "glob": "^13.0.6",
    "picomatch": "^4.0.4",
    "webpack": "^5.107.2",
    "multer": "2.3.0",
    "fast-uri": "3.1.6"
  }
}
